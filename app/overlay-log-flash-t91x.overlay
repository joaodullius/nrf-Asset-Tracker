/* Application log kept in a littlefs on the Thingy:91 X external flash, right after the
 * modem trace partition of overlay-modem-trace-flash-t91x.overlay (0x4d2000 + 4 MB).
 * Read it with the shell: `fs ls /lfs1`, `fs cat /lfs1/log.00000`.
 */

&flash_ext {
	partitions {
		lfs_log: partition@8d2000 {
			label = "lfs_log";
			reg = <0x008d2000 0x100000>;
		};
	};
};

/ {
	fstab {
		compatible = "zephyr,fstab";

		lfs1: lfs1 {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs1";
			partition = <&lfs_log>;
			automount;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};
